# 配置模板：复制成 .env 后填入真实值
#   cp .env.example .env

# 阿里云百炼兼容 OpenAI 协议的地址
# 如果是专属网关，形如 https://xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=

# DashScope / 百炼的 API Key
OPENAI_API_KEY=

# 商城基础地址（不包含 /users/csrf 等接口路径）
MALL_BASE_URL=http://localhost:8080

# 匿名会话签名密钥：至少32字符，生成后固定保存，不能提交真实值
# python -c "import secrets; print(secrets.token_hex(32))"
AGENT_SESSION_SECRET=

# 同域浏览器POST可信来源，只有scheme://host[:port]，无路径
AGENT_PUBLIC_ORIGIN=http://localhost:8000
